@@ -0,0 +1,49 @@
+"""转专业问答。
+
+QQ 官方机器人发送侧只有 msg_type 0/2/3/7（文本、markdown、ark、富媒体），
+没有合并转发，所以答案和出处必须一条消息说完。长答案按 ANSWER_LIMIT 截断，
+出处的完整位置靠底部按钮跳原文。
+
+数据来自 fzurun-assistant 的 /api/ask。
+"""
+
+from nonebot import logger, on_command
+from nonebot.adapters.qq import GroupMessageCreateEvent, Message, MessageSegment
+from nonebot.params import CommandArg
+
+from .. import config
+from ..markdown.keyboard import link_keyboard
+from ..util import describe_error
+from .api import build_reply, fetch_answer, source_url
+
+change_major = on_command("转专业", priority=20, block=True)
+
+
+@change_major.handle()
+async def _(event: GroupMessageCreateEvent, arg: Message = CommandArg()):  # noqa: B008
+    # 配了群就只在那个群响应，没配就哪儿都能用
+    if config.change_major_group_openid and event.group_openid != config.change_major_group_openid:
+        return
+
+    question = arg.extract_plain_text().strip()
+    if not question:
+        await change_major.finish("用法：/转专业 我挂过科还能转吗")
+
+    try:
+        data = await fetch_answer(
+            config.change_major_api_base,
+            question,
+            config.change_major_timeout,
+        )
+    except Exception as error:  # noqa: BLE001
+        logger.warning(f"转专业问答请求失败：{error!r}")
+        await change_major.finish(f"转专业助手暂时连不上。\n{describe_error(error)}")
+
+    reply = MessageSegment.markdown(build_reply(data))
+
+    top = next(iter(data.get("citations") or []), {})
+    url = source_url(config.change_major_site_url, top.get("anchor"))
+    if url:
+        reply += link_keyboard(url, "📖 查看原文")
+
+    await change_major.finish(reply)
diff --git a/klee/change_major/api.py b/klee/change_major/api.py
new file mode 100644
index 0000000..7568f78
--- /dev/null
+++ b/klee/change_major/api.py
@@ -0,0 +1,95 @@
+"""转专业问答的 HTTP 客户端和消息拼装。
+
+这个文件不 import 包内任何东西，也不碰 nonebot，方便单独跑：
+
+    import importlib.util
+    spec = importlib.util.spec_from_file_location("cm", "klee/change_major/api.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+
+对端是 fzurun-assistant：
+
+    POST /api/ask  {"query": "..."}
+    -> {"answer", "gate", "citations", "navigation", "note", "caveats",
+        "mode", "request_id", "latency_ms"}
+"""
+
+from __future__ import annotations
+
+import httpx
+
+# 一条消息塞多少字。QQ 的 markdown 上限比这宽，但太长了没人读，
+# 而且官方机器人没有合并转发，没法折叠。
+ANSWER_LIMIT = 800
+MAX_CITES = 3
+MAX_CAVEATS = 2
+
+
+def clip(text: str, limit: int = ANSWER_LIMIT) -> str:
+    text = (text or "").strip()
+    if len(text) <= limit:
+        return text
+    return text[:limit].rstrip() + "……"
+
+
+def source_url(site_base: str, anchor: str | None) -> str:
+    """拼原文链接。站点地址没配就返回空串，调用方据此决定要不要加按钮。"""
+    base = (site_base or "").strip().rstrip("/")
+    if not base or not anchor:
+        return ""
+    return f"{base}#{anchor}"
+
+
+def build_reply(data: dict) -> str:
+    """把 /api/ask 的返回拼成一条 markdown。纯函数，不依赖网络。"""
+    gate = data.get("gate") or ""
+    answer = (data.get("answer") or "").strip()
+
+    if gate == "irrelevant" or not answer:
+        lines = ["## 没查到", "", "知识库里没有和这个问题相关的内容。"]
+        labels = [i.get("label") for i in (data.get("navigation") or []) if i.get("label")]
+        if labels:
+            lines += ["", "可能是想问："]
+            lines += [f"- {label}" for label in labels[:3]]
+        return "\n".join(lines)
+
+    lines = ["## 转专业问答", "", clip(answer)]
+
+    note = (data.get("note") or "").strip()
+    if note:
+        lines += ["", f"> {note}"]
+
+    for caveat in (data.get("caveats") or [])[:MAX_CAVEATS]:
+        lines.append(f"> 注意：{caveat}")
+
+    cites: list[dict] = []
+    seen: set[str] = set()
+    for item in data.get("citations") or []:
+        key = item.get("id")
+        if not key or key in seen:
+            continue
+        seen.add(key)
+        cites.append(item)
+        if len(cites) >= MAX_CITES:
+            break
+
+    if cites:
+        lines += ["", "**出处**"]
+        for item in cites:
+            section = (item.get("section") or "").strip()
+            label = (item.get("label") or "").strip()
+            lines.append(f"- {section} · {label}" if section else f"- {label}")
+
+    if data.get("mode") == "llm":
+        lines += ["", "> 以上由模型从原文摘录，以原文为准。"]
+
+    return "\n".join(lines)
+
+
+async def fetch_answer(api_base: str, question: str, timeout: float) -> dict:
+    """调一次 /api/ask。异常交给调用方处理，这里只负责把 HTTP 细节收干净。"""
+    url = (api_base or "").strip().rstrip("/") + "/api/ask"
+    async with httpx.AsyncClient(timeout=timeout) as client:
+        resp = await client.post(url, json={"query": question, "client": "qqbot"})
+        resp.raise_for_status()
+        return resp.json()
