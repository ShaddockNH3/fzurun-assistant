+#!/usr/bin/env python3
+"""不启动 bot，单独验证转专业问答模块。
+
+    uv run python scripts/preview_change_major.py
+    uv run python scripts/preview_change_major.py "我挂过科还能转专业吗"
+    uv run python scripts/preview_change_major.py --api http://127.0.0.1:8000
+
+两段：先用假数据走一遍拼装逻辑（覆盖拒答、截断、出处去重），
+再真发一次 HTTP 给 fzurun-assistant，把会发出去的 markdown 打印出来。
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import importlib.util
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location(
+    "cm_api", ROOT / "klee" / "change_major" / "api.py"
+)
+if SPEC is None or SPEC.loader is None:
+    raise SystemExit("找不到 klee/change_major/api.py")
+api = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(api)
+
+SITE = "https://example.com/posts/FZU/overview/"
+
+FAKE_OK = {
+    "answer": "可以。福州大学不限制挂过科的转专业，唯一需要注意的是面试时老师会问你为什么挂。",
+    "mode": "llm",
+    "gate": "strong",
+    "citations": [
+        {"id": "1.2.q7", "section": "1.2 我能不能转", "label": "我挂过科，大二还能转专业吗？",
+         "anchor": "q7我挂过科大二还能转专业吗"},
+        {"id": "1.2.q7", "section": "1.2 我能不能转", "label": "重复的引用应该被去掉",
+         "anchor": "x"},
+        {"id": "2.4.q1", "section": "2.4 笔试与面试", "label": "面试重要吗", "anchor": "y"},
+    ],
+    "navigation": [],
+    "caveats": ["文档未说明各学院对挂科门数是否有内部限制"],
+    "note": "",
+}
+
+FAKE_MISS = {
+    "answer": "文档里没有找到和这个问题相关的内容。",
+    "mode": "retrieval_only",
+    "gate": "irrelevant",
+    "citations": [],
+    "navigation": [
+        {"id": "ref.1.4.ratio", "label": "25 年大一转专业报录比（经验值）"},
+        {"id": "1.2.q6", "label": "我是 24 级的地质工程专业，可以转专业吗？"},
+    ],
+    "caveats": [],
+    "note": "",
+}
+
+FAKE_LONG = {
+    "answer": "长" * 1200,
+    "mode": "retrieval_only",
+    "gate": "strong",
+    "citations": [{"id": "ref.1.4.ratio", "section": "1.4 竞争有多激烈",
+                   "label": "25 年大一转专业报录比（经验值）", "anchor": "ratio"}],
+    "navigation": [], "caveats": [], "note": "以下为非官方经验值，仅供参照。",
+}
+
+
+def show(title: str, data: dict) -> None:
+    text = api.build_reply(data)
+    top = next(iter(data.get("citations") or []), {})
+    url = api.source_url(SITE, top.get("anchor"))
+    print(f"\n{'=' * 60}\n{title}　（{len(text)} 字）\n{'=' * 60}")
+    print(text)
+    print(f"\n[按钮] {'📖 查看原文 -> ' + url if url else '无（没配站点地址或没有锚点）'}")
+
+
+async def real(api_base: str, question: str) -> int:
+    print(f"\n{'=' * 60}\n真实请求　{question}\n{'=' * 60}")
+    try:
+        data = await api.fetch_answer(api_base, question, 30.0)
+    except Exception as error:  # noqa: BLE001
+        print(f"失败：{error!r}")
+        return 1
+
+    text = api.build_reply(data)
+    print(f"gate={data.get('gate')}  mode={data.get('mode')}  "
+          f"latency={data.get('latency_ms')}ms  request_id={data.get('request_id')}")
+    print(f"消息长度 {len(text)} 字\n")
+    print(text)
+
+    top = next(iter(data.get("citations") or []), {})
+    url = api.source_url(SITE, top.get("anchor"))
+    print(f"\n[按钮] {'📖 查看原文 -> ' + url if url else '无'}")
+    return 0
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("question", nargs="?", default="我挂过科还能转专业吗")
+    ap.add_argument("--api", default="http://127.0.0.1:8000")
+    ap.add_argument("--offline", action="store_true", help="只跑假数据，不发请求")
+    args = ap.parse_args()
+
+    show("正常命中", FAKE_OK)
+    show("拒答", FAKE_MISS)
+    show("超长答案（应截断）", FAKE_LONG)
+
+    if args.offline:
+        return 0
+    return asyncio.run(real(args.api, args.question))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
