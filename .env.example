# 全部可选。一个都不配也能跑：只有 BM25 检索，直接返回知识库原文。

# ---- 生成模型（OpenAI 兼容）----
# 智谱：https://open.bigmodel.cn/api/paas/v4   glm-4.5-flash（免费，要关思考）
# 本地 vllm：http://localhost:8000/v1          模型填服务端 --served-model-name
# Ollama：http://localhost:11434/v1            模型 qwen2.5:3b
# Groq：https://api.groq.com/openai/v1         模型 openai/gpt-oss-120b
FZURUN_LLM_BASE_URL=
FZURUN_LLM_API_KEY=
FZURUN_LLM_MODEL=

# 智谱的 Flash 系列默认开思考，会和答案抢 token，必须显式关掉。
# 换别家（vllm / Ollama / Groq）就把这行删掉，它们不认这个参数。
# 实测：glm-4.5-flash 13.4s -> 4.3s，glm-4.7-flash 20.3s -> 9.6s
FZURUN_LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}

# 0 表示不传，用服务端默认
FZURUN_LLM_MAX_TOKENS=0

# ---- Embedding（OpenAI 兼容），配了才启用向量通道 ----
FZURUN_EMBED_BASE_URL=
FZURUN_EMBED_API_KEY=
FZURUN_EMBED_MODEL=

# ---- 检索参数 ----
# 门控阈值按 99 条语料标定过，语料大改之后要重标
FZURUN_TOP_K=5
FZURUN_RRF_K=60

# ---- 试运行观测 ----
# 每次问答写一行 JSONL 到 data/logs/。
# 不想留问题原文就把 LOG_QUERY 设成 false，只记门控和命中。
FZURUN_LOG_ENABLED=true
FZURUN_LOG_QUERY=true
FZURUN_LOG_DIR=data/logs
